# Copy this file to .env and fill in your own values.

# --- OpenAI (LLM: gpt-4o-mini) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini


# --- LangSmith observability ---
# Optional: tracing (@traceable) is skipped gracefully if LANGCHAIN_TRACING_V2
# is unset or false — no API key required to run the app without it.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=ai-document-simplifier

# --- Embeddings ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Guardrails ---
# NOTE: verify this exact model ID on HuggingFace before demo day
# (see ARCHITECTURE.md > Guardrails).
PROMPT_INJECTION_MODEL_NAME=protectai/deberta-v3-base-prompt-injection-v2
PROMPT_INJECTION_THRESHOLD=0.5
SCOPE_SIMILARITY_THRESHOLD=0.3
# Dev-time escape hatch — set to false to skip downloading/loading the
# prompt-injection classifier (e.g. slow connection while iterating on the
# core pipeline). Defaults to true; re-enable before demoing the guardrail.
ENABLE_PROMPT_INJECTION_CHECK=true

# --- Chunking (semantic, bounded to a min/max sentence-count band) ---
CHUNK_MIN_SENTENCES=10
CHUNK_MAX_SENTENCES=20
CHUNK_OVERLAP_SENTENCES=2

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RRF_K=60

# --- Simplification: chunks combined per LLM call (cuts call volume on large docs) ---
SIMPLIFY_BATCH_SIZE=5

# --- Frontend ---
BACKEND_URL=http://localhost:8001
